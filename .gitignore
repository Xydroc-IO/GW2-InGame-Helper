# Addon runtime data (API key, notes, Live caches) — never commit if copied into the tree
notes.json
live-*.json
live-*.html
live-*.ok
live-*.ver
**/addons/GW2-InGame-Helper/**

# Android companion (local-only; not published with the Nexus addon)
Companion-App/

# Android / Java signing material (never commit private keys)
*.jks
*.keystore
keystore.properties

# Local listing / announcement drafts (keep on disk; do not publish in git)
docs/DISCORD.md
docs/DISCORD_*.md
docs/RAIDCORE.md
docs/CODE_AUDIT.md
docs/ARCHITECTURE.md
docs/WHITEPAPER.md
docs/SNOWCROWS.md
docs/RELEASE_NOTES_BETA.md

# Python (if helpers scripts appear later)
__pycache__/
*.pyc
.venv/
venv/
